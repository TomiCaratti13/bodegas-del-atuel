# ==============================================================================
# Bodegas del Atuel - Variables de entorno (EJEMPLO SIN SECRETOS)
# Copiar a .env para ejecucion local: cp .env.example .env
# ==============================================================================

# PostgreSQL (usuario propietario / migraciones)
POSTGRES_DB=bodegas_atuel
POSTGRES_USER=bodegas_owner
POSTGRES_PASSWORD=CAMBIAR_ESTE_SECRETO_OWNER
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Rol de privilegios minimos usado por la API (lectura/escritura, no propietario)
API_DB_USER=app_rw
API_DB_PASSWORD=CAMBIAR_ESTE_SECRETO_APP_RW

# Rol de solo lectura para reportes
RO_DB_USER=app_ro
RO_DB_PASSWORD=CAMBIAR_ESTE_SECRETO_APP_RO

# API REST
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Frontend
VITE_API_URL=http://localhost:8000
